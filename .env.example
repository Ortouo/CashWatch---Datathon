# Generate a private random key with: python scripts/init_env.py
CASHWATCH_API_KEY=
CASHWATCH_MODEL_DIR=./models/Qwen3-VL-2B-Instruct
CASHWATCH_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
CASHWATCH_DEVICE=auto
CASHWATCH_DATA_DIR=./runtime
CASHWATCH_RULES_PATH=./config/rules.json
# Includes time spent waiting after acceptance. Jury limit: 300 seconds.
CASHWATCH_TIMEOUT_SEC=275
CASHWATCH_MAX_INFLIGHT=1
CASHWATCH_MAX_UPLOAD_MB=100
CASHWATCH_MAX_DURATION_SEC=180
# Sampling settings are baseline hypotheses. Validate on local held-out videos.
CASHWATCH_SAMPLE_FPS=1
CASHWATCH_WINDOW_SEC=12
CASHWATCH_OVERLAP_SEC=2
CASHWATCH_MAX_FRAMES_PER_WINDOW=16
CASHWATCH_MAX_NEW_TOKENS=768
CASHWATCH_IMAGE_EDGE=768
# Automatic local deletion after one hour. Raw video removed immediately after job.
CASHWATCH_RETENTION_HOURS=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1

